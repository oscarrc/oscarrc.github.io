---
import type { CollectionEntry } from "astro:content";

import ProjectCard from "./ProjectCard.astro";

interface Props {
  items: CollectionEntry<"projects">[];
  /** Offset for the staggered entrance, so sections reveal in sequence. */
  baseDelay?: number;
  /** Render names in mono — for libraries, whose names are code identifiers. */
  mono?: boolean;
}

const { items, baseDelay = 0, mono = false } = Astro.props;
---

{
  items.length > 0 && (
    <ul
      class="grid grid-cols-[repeat(auto-fill,minmax(6rem,1fr))] gap-x-4 gap-y-7"
      role="list"
    >
      {items.map((project, i) => (
        <li data-reveal style={`--i: ${baseDelay + i + 1}`}>
          <ProjectCard project={project} mono={mono} />
        </li>
      ))}
    </ul>
  )
}
