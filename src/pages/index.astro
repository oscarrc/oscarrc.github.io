---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SectionBar from "../components/SectionBar.astro";
import Footer from "../components/Footer.astro";
import CursorBubble from "../components/CursorBubble.astro";

const projects = await getCollection("projects");
const byOrder = (a: (typeof projects)[number], b: (typeof projects)[number]) =>
  a.data.order - b.data.order;

const apps = projects.filter((p) => p.data.type === "app").sort(byOrder);
const libraries = projects
  .filter((p) => p.data.type === "library")
  .sort(byOrder);

const edge = "border-base-300";
---

<Layout>
  {/* first in DOM so every positioned column paints above it */}
  <div
    class="bg-blueprint-page pointer-events-none fixed inset-0"
    aria-hidden="true"
  >
    {
      /* a single light pulse that travels along the grid lines, driven by the script below */
    }
    <div
      id="grid-pulse"
      class="absolute top-0 left-0 opacity-0 will-change-transform"
    >
    </div>
  </div>

  <div class="flex min-h-dvh flex-col">
    {
      /*
      One flat stack of sticky siblings (the shared containing block): the
      navbar, then each section's `SectionBar` + its grid. As you scroll the
      hero collapses and stays pinned, and each bar sticks beneath it, the
      headers accumulating at the top while the cards scroll under (see
      global.css). Each column owns its own solid fill; only the navbar carries
      the gradient so the grid bleeds through its top. `flex-1` on the last
      grid stretches the framed column to meet the footer.
    */
    }
    <div class="relative flex flex-1 flex-col">
      {/* Navbar — the hero; collapses on scroll and stays pinned. The visual
          column is `.hero-inner`; `.hero-track` (below) reserves the scroll. */}
      <header class="hero-col">
        <div
          class:list={[
            "hero-inner mx-auto w-full max-w-3xl border-x bg-linear-to-t from-base-100 from-50% to-transparent",
            edge,
          ]}
        >
          <div class="hero-content" data-reveal style="--i: 0">
            <h1 class="hero-title font-extrabold tracking-[-0.02em] leading-[0.98]">
              OSCAR RC
            </h1>
            <p class="hero-slogan leading-relaxed text-secondary">
              Web developer &amp; software architect
            </p>
          </div>
        </div>
      </header>
      <div class="hero-track" aria-hidden="true"></div>

      <SectionBar id="sec-apps" label="Apps" count={apps.length} index={0} baseDelay={1} />
      <section
        aria-labelledby="sec-apps"
        class:list={[
          "mx-auto w-full max-w-3xl border-x bg-base-100 px-6 pt-4 pb-14",
          edge,
        ]}
      >
        <ProjectGrid items={apps} baseDelay={1} mono />
      </section>

      <SectionBar
        id="sec-libraries"
        label="Libraries"
        count={libraries.length}
        index={1}
        baseDelay={apps.length + 2}
      />
      {/* flex-1 so the framed column stretches to meet the footer */}
      <section
        aria-labelledby="sec-libraries"
        class:list={[
          "mx-auto w-full max-w-3xl flex-1 border-x bg-base-100 px-6 pt-4 pb-14",
          edge,
        ]}
      >
        <ProjectGrid items={libraries} baseDelay={apps.length + 2} mono />
      </section>
    </div>

    <Footer />
  </div>

  <CursorBubble />
</Layout>

<script>
  /*
   * Grid pulse — one dot of light with a tail travelling along a random
   * blueprint-grid line. transform-only (composited), one at a time,
   * silent under prefers-reduced-motion or when the tab is hidden.
   */
  const pulse = document.getElementById("grid-pulse");
  const CELL = 56; // must match .bg-blueprint-page background-size
  const SPEED = 640; // px/s — constant speed regardless of span
  const TAIL = 96;
  const COLUMN = 768; // max-w-3xl, the solid center column
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  function verticalCandidates(w: number): number[] {
    // only grid lines in the gutters — center ones are hidden behind the column
    const left = (w - Math.min(w, COLUMN)) / 2;
    const right = w - left;
    const xs = [];
    for (let x = CELL; x < w; x += CELL) if (x < left || x > right) xs.push(x);
    return xs;
  }

  async function run() {
    if (!pulse || reduced.matches) return;
    if (document.hidden) return schedule();

    const w = innerWidth;
    const h = innerHeight;
    const verticals = verticalCandidates(w);
    if (w - Math.min(w, COLUMN) < CELL * 2) return schedule(); // gutters too thin to see anything

    const horizontal = verticals.length === 0 || Math.random() < 0.5;
    const line = horizontal
      ? Math.floor(rand(1, Math.floor(h / CELL))) * CELL
      : verticals[Math.floor(Math.random() * verticals.length)];
    const forward = Math.random() < 0.5;
    const span = horizontal ? w : h;

    // tail fades out behind the direction of travel; head is the bright tip
    const dir = horizontal
      ? forward
        ? "right"
        : "left"
      : forward
        ? "bottom"
        : "top";
    pulse.style.width = horizontal ? `${TAIL}px` : "1px";
    pulse.style.height = horizontal ? "1px" : `${TAIL}px`;
    pulse.style.background = `linear-gradient(to ${dir}, transparent, oklch(88% 0.006 285 / 0.5) 75%, oklch(96% 0.004 285 / 0.95))`;
    pulse.style.opacity = "1";

    const at = (p: number) =>
      horizontal
        ? `translate3d(${p}px, ${line}px, 0)`
        : `translate3d(${line}px, ${p}px, 0)`;
    const from = forward ? -TAIL : span;
    const to = forward ? span : -TAIL;
    const duration = ((span + TAIL) / SPEED) * 1000;

    try {
      await pulse.animate([{ transform: at(from) }, { transform: at(to) }], {
        duration,
        easing: "linear",
      }).finished;
    } catch {
      /* animation cancelled — fall through to reschedule */
    }
    pulse.style.opacity = "0";
    schedule();
  }

  function schedule() {
    setTimeout(run, rand(600, 2000));
  }

  reduced.addEventListener("change", () => {
    if (!reduced.matches) schedule();
  });
  if (!reduced.matches) schedule();
</script>
