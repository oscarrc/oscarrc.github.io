---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Oscar R.C. — Web Developer & Software Architect',
  description = 'Apps and open-source libraries by Oscar R.C., web developer and software architect.'
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="carbide">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-hubot" preload />
    <Font cssVariable="--font-commit-mono" preload />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-base-100 font-sans text-base-content antialiased">
    <slot />
  </body>
</html>
